# /admin 임시 보호 (Supabase Auth 연결 전까지 — TECHNICAL_SPEC §3 Auth 참조)
# 미설정 시 /admin은 전부 401 (fail-closed). Vercel 배포 시 반드시 설정할 것.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# 배포 도메인 (OG 이미지·메타데이터 절대경로 계산용, app/layout.tsx metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 후원 링크 (토스아이디 송금 링크·Buy Me a Coffee 등) — 미설정 시 후원 UI 숨김
NEXT_PUBLIC_SUPPORT_URL=

# 카카오맵 JS 키 (developers.kakao.com → 앱 생성 → JavaScript 키, 플랫폼에 배포 도메인 등록 필수)
# 미설정 시 /map은 리스트만 표시 (지도 섹션 자동 숨김)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Supabase (프로젝트: bean-checker, ap-northeast-2) — 미설정 시 앱은 시드 데이터로 폴백
NEXT_PUBLIC_SUPABASE_URL=https://xtczrghymzuvavutdqzn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=      # server-only, 절대 NEXT_PUBLIC_ 접두사 금지 (CLAUDE.md §6)
